POSTGRES_DB=shl_operations
POSTGRES_USER=shl_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-long-random-password

MFA_ENCRYPTION_KEY=replace-with-64-hex-characters-before-enabling-mfa

# Exact comma-separated staff usernames. Empty means nobody (including ADMIN) can see commissions.
COMMISSION_AUTHORIZED_USERS=

# Development default is false. Turn on after reviewing policy and rollout.
# Enforced mode restricts unenrolled users to authenticator setup only.
MFA_ENFORCEMENT_ENABLED=false

# Set only after security approval; enabling production mode requires mandatory MFA.
SHL_DEPLOYMENT_MODE=development
# Offsite backup secrets and age recovery identity are not stored in this .env or Git.

# Public browser origin for CSRF comparison; set to the exact HTTPS site in staging/production.
SHL_PUBLIC_ORIGIN=http://127.0.0.1:3000
