# Local development settings
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/northstar

# API Service
API_PORT=8080
JWT_SECRET=your_jwt_secret_here

# Next.js auth: set these in apps/web/.env.local when running the web app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SHL_PUBLIC_ORIGIN=http://localhost:3000
SHL_AUTH_ALLOWED_EMAILS=your-owner-email@example.com
